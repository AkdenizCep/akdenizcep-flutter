{
  "name": "akdenizcep-functions",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "lib/src/index.js",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test --test-concurrency=1 \"lib/test/*.test.js\"",
    "test:rules": "npm run build && node --test --test-concurrency=1 \"lib/test/*.rules.test.js\"",
    "admins:bootstrap": "npm run build && node lib/scripts/bootstrap-admins.js",
    "schema:inventory": "npm run build && node lib/scripts/schema-inventory.js",
    "schema:backfill": "npm run build && node lib/scripts/backfill-schema.js"
  },
  "dependencies": {
    "cloudinary": "2.11.0",
    "firebase-admin": "14.3.0",
    "firebase-functions": "7.3.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "22.18.0",
    "firebase-tools": "^15.29.0",
    "typescript": "5.9.2"
  }
}
