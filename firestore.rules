rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isAkdenizStudent() {
      return isSignedIn() && request.auth.token.email is string &&
        request.auth.token.email.matches('.*@ogr[.]akdeniz[.]edu[.]tr$');
    }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return isAkdenizStudent() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function adminConfig() {
      return get(/databases/$(database)/documents/admin_config/current).data;
    }
    function adminConfigAfter() {
      return getAfter(/databases/$(database)/documents/admin_config/current).data;
    }
    function targetIsStudent(uid) {
      let target = get(/databases/$(database)/documents/users/$(uid)).data;
      return target.email is string &&
        target.email.matches('.*@ogr[.]akdeniz[.]edu[.]tr$');
    }
    function canCreateStudentContent() {
      let user = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isAkdenizStudent() && (
        user.postingRestricted != true ||
        (user.postingRestrictedUntil is timestamp &&
          user.postingRestrictedUntil <= request.time)
      );
    }
    function isVisible() { return resource.data.moderationStatus == 'visible'; }
    function createsVisibleContent() {
      return request.resource.data.moderationStatus == 'visible' &&
        request.resource.data.moderatedAt == null &&
        request.resource.data.moderatedBy == null;
    }
    function isAdminModerationUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isAdmin() &&
        changed.hasOnly(['moderationStatus', 'moderatedAt', 'moderatedBy']) &&
        request.resource.data.moderationStatus in ['visible', 'hidden'] &&
        (request.resource.data.moderatedAt == request.time || request.resource.data.moderatedAt is timestamp) &&
        request.resource.data.moderatedBy == request.auth.uid;
    }
    function isAdminUserUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isAdmin() && (
        changed.hasOnly(['photoUrl', 'bio']) ||
        (
          changed.hasOnly([
            'photoUrl', 'bio', 'postingRestricted', 'postingRestrictedUntil',
            'restrictionUpdatedAt', 'restrictionUpdatedBy'
          ]) &&
          changed.hasAny(['postingRestricted', 'postingRestrictedUntil']) &&
          request.resource.data.restrictionUpdatedBy == request.auth.uid &&
          (request.resource.data.restrictionUpdatedAt == request.time || request.resource.data.restrictionUpdatedAt is timestamp)
        )
      );
    }
    function isValidVoteChange(uid) {
      let beforeVotes = resource.data.votes is map ? resource.data.votes : {};
      let afterVotes = request.resource.data.votes is map ? request.resource.data.votes : {};
      let voteDiff = afterVotes.diff(beforeVotes);
      return voteDiff.affectedKeys().hasOnly([uid]) &&
        (!(uid in afterVotes) || afterVotes[uid] in [1, -1]);
    }
    function isValidAttendanceChange(uid) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let beforeIds = resource.data.attendeeIds is list ? resource.data.attendeeIds : [];
      let afterIds = request.resource.data.attendeeIds is list ? request.resource.data.attendeeIds : [];
      let joined = afterIds.toSet().difference(beforeIds.toSet());
      let left = beforeIds.toSet().difference(afterIds.toSet());
      return changed.hasOnly(['attendeeIds', 'attendeeCount']) &&
        joined.hasOnly([uid]) && left.hasOnly([uid]) &&
        request.resource.data.attendeeCount == afterIds.size();
    }
    function isValidLikeChange(uid) {
      let beforeLikes = resource.data.likedBy is list ? resource.data.likedBy : [];
      let afterLikes = request.resource.data.likedBy is list ? request.resource.data.likedBy : [];
      let added = afterLikes.toSet().difference(beforeLikes.toSet());
      let removed = beforeLikes.toSet().difference(afterLikes.toSet());
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy']) &&
        added.hasOnly([uid]) && removed.hasOnly([uid]);
    }
    function isClubPresident(clubId) {
      return isAkdenizStudent() && request.auth.uid ==
        get(/databases/$(database)/documents/clubs/$(clubId)).data.adminUid;
    }
    function clubAdminUids(clubId) {
      let club = get(/databases/$(database)/documents/clubs/$(clubId)).data;
      return 'adminUids' in club ? club.adminUids : [];
    }
    function isClubAdmin(clubId) {
      return isClubPresident(clubId) ||
        (isAkdenizStudent() && request.auth.uid in clubAdminUids(clubId));
    }
    function isResourceClubPresident() {
      return isAkdenizStudent() && request.auth.uid == resource.data.adminUid;
    }
    function isResourceClubAdmin() {
      return isResourceClubPresident() ||
        (isAkdenizStudent() && request.auth.uid in
          ('adminUids' in resource.data ? resource.data.adminUids : []));
    }

    match /admins/{uid} {
      allow get: if isAkdenizStudent() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin() &&
        !exists(/databases/$(database)/documents/admins/$(uid)) &&
        targetIsStudent(uid) &&
        request.resource.data.keys().hasOnly(['uid', 'email', 'createdAt', 'createdBy']) &&
        request.resource.data.uid == uid &&
        request.resource.data.email == get(/databases/$(database)/documents/users/$(uid)).data.email &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.createdBy == request.auth.uid &&
        adminConfigAfter().adminCount == adminConfig().adminCount + 1 &&
        adminConfigAfter().revision == adminConfig().revision + 1 &&
        adminConfigAfter().lastChangedUid == uid &&
        adminConfigAfter().lastChangeType == 'add';
      allow delete: if isAdmin() && adminConfig().adminCount > 1 &&
        adminConfigAfter().adminCount == adminConfig().adminCount - 1 &&
        adminConfigAfter().revision == adminConfig().revision + 1 &&
        adminConfigAfter().lastChangedUid == uid &&
        adminConfigAfter().lastChangeType == 'remove';
      allow update: if false;
    }

    match /admin_config/current {
      allow read: if isAdmin();
      allow create, delete: if false;
      allow update: if isAdmin() &&
        request.resource.data.keys().hasOnly([
          'adminCount', 'revision', 'lastChangedUid', 'lastChangeType',
          'updatedAt', 'updatedBy'
        ]) &&
        request.resource.data.adminCount >= 1 &&
        request.resource.data.revision == resource.data.revision + 1 &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.updatedBy == request.auth.uid &&
        (
          (request.resource.data.lastChangeType == 'add' &&
            request.resource.data.adminCount == resource.data.adminCount + 1 &&
            !exists(/databases/$(database)/documents/admins/$(request.resource.data.lastChangedUid)) &&
            existsAfter(/databases/$(database)/documents/admins/$(request.resource.data.lastChangedUid))) ||
          (request.resource.data.lastChangeType == 'remove' &&
            resource.data.adminCount > 1 &&
            request.resource.data.adminCount == resource.data.adminCount - 1 &&
            exists(/databases/$(database)/documents/admins/$(request.resource.data.lastChangedUid)) &&
            !existsAfter(/databases/$(database)/documents/admins/$(request.resource.data.lastChangedUid)))
        );
    }

    match /users/{uid} {
      allow read: if isAkdenizStudent();
      allow create: if isOwner(uid) &&
        request.resource.data.email == request.auth.token.email;
      allow update: if (
        isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['followedClubs', 'ratedMealIds', 'savedEventIds', 'photoUrl'])
      ) || isAdminUserUpdate();
      allow delete: if false;
    }

    match /clubs/{clubId} {
      allow read: if isAkdenizStudent();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isAkdenizStudent() && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followerCount']) ||
        (isResourceClubAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'description', 'category', 'logoUrl', 'coverUrl', 'foundedYear'
        ])) ||
        (isResourceClubPresident() && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['adminUids']))
      ));

      match /members/{memberUid} {
        allow read: if isAkdenizStudent();
        allow create: if (isAdmin() || isClubPresident(clubId)) &&
          get(/databases/$(database)/documents/clubs/$(clubId)).data.active == true;
        allow delete: if isAdmin() || isClubPresident(clubId);
        allow update: if false;
      }

      match /club-events/{ceventId} {
        allow read: if isAdmin() || isVisible();
        allow create: if (isAdmin() || isClubAdmin(clubId)) &&
          get(/databases/$(database)/documents/clubs/$(clubId)).data.active == true &&
          createsVisibleContent();
        allow delete: if isAdmin() || isClubAdmin(clubId);
        allow update: if isAdminModerationUpdate() || isAdmin() ||
          (isAkdenizStudent() &&
            (isClubAdmin(clubId) || isValidAttendanceChange(request.auth.uid)));

        match /comments/{commentId} {
          allow read: if isAdmin() || (isVisible() &&
            get(/databases/$(database)/documents/clubs/$(clubId)/club-events/$(ceventId))
              .data.moderationStatus == 'visible');
          allow create: if canCreateStudentContent() &&
            request.auth.uid == request.resource.data.authorUid &&
            get(/databases/$(database)/documents/clubs/$(clubId)/club-events/$(ceventId))
              .data.moderationStatus == 'visible' && createsVisibleContent();
          allow update: if isAdminModerationUpdate() ||
            (isAkdenizStudent() && request.auth.uid == resource.data.authorUid &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text']));
          allow delete: if isAdmin() ||
            (isAkdenizStudent() && request.auth.uid == resource.data.authorUid);
        }

        match /attendance/{attendeeUid} {
          allow read: if isAdmin() || isClubAdmin(clubId);
          allow create: if isClubAdmin(clubId) &&
            request.resource.data.recordedBy == request.auth.uid;
          allow update: if false;
          allow delete: if isAdmin();
        }
      }
    }

    match /{path=**}/club-events/{ceventId} {
      allow read: if isAdmin() || isVisible();
      allow update: if isAdminModerationUpdate() || isAdmin();
      allow delete: if isAdmin();
    }

    match /{path=**}/comments/{commentId} {
      allow read: if isAdmin() || isVisible();
      allow update: if isAdminModerationUpdate();
      allow delete: if isAdmin();
    }

    match /{path=**}/members/{memberUid} {
      allow read: if isAkdenizStudent();
    }

    match /{path=**}/attendance/{attendeeUid} {
      allow read: if isAdmin();
    }

    match /{path=**}/ratings/{uid} {
      allow read: if isAkdenizStudent();
    }

    match /announcements/{announcementId} {
      allow read: if isAdmin() ||
        (isAkdenizStudent() && resource.data.status == 'published');
      allow create, update, delete: if isAdmin();
    }

    match /student-events/{seventId} {
      allow read: if isAdmin() || isVisible();
      allow create: if canCreateStudentContent() &&
        request.auth.uid == request.resource.data.authorUid && createsVisibleContent();
      allow delete: if isAdmin() ||
        (isAkdenizStudent() && request.auth.uid == resource.data.authorUid);
      allow update: if isAdminModerationUpdate() ||
        (isAkdenizStudent() && (
          (request.auth.uid == resource.data.authorUid &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'authorUid', 'createdAt', 'moderationStatus', 'moderatedAt', 'moderatedBy'
            ])) || isValidAttendanceChange(request.auth.uid)
        ));

      match /comments/{commentId} {
        allow read: if isAdmin() || (isVisible() &&
          get(/databases/$(database)/documents/student-events/$(seventId))
            .data.moderationStatus == 'visible');
        allow create: if canCreateStudentContent() &&
          request.auth.uid == request.resource.data.authorUid &&
          get(/databases/$(database)/documents/student-events/$(seventId))
            .data.moderationStatus == 'visible' && createsVisibleContent();
        allow update: if isAdminModerationUpdate() ||
          (isAkdenizStudent() && request.auth.uid == resource.data.authorUid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text']));
        allow delete: if isAdmin() ||
          (isAkdenizStudent() && request.auth.uid == resource.data.authorUid);
      }
    }

    match /lost_found_items/{itemId} {
      allow read: if isAdmin() || isVisible();
      allow create: if canCreateStudentContent() &&
        request.auth.uid == request.resource.data.authorUid && createsVisibleContent();
      allow update: if isAdminModerationUpdate() ||
        (isAkdenizStudent() && request.auth.uid == resource.data.authorUid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isResolved']));
      allow delete: if isAdmin() ||
        (isAkdenizStudent() && request.auth.uid == resource.data.authorUid);
    }

    match /campus_photos/{photoId} {
      allow read: if isAdmin() || isVisible();
      allow create: if canCreateStudentContent() &&
        request.auth.uid == request.resource.data.authorUid && createsVisibleContent();
      allow update: if isAdminModerationUpdate() ||
        (isAkdenizStudent() && isValidLikeChange(request.auth.uid));
      allow delete: if isAdmin() ||
        (isAkdenizStudent() && request.auth.uid == resource.data.authorUid);

      match /comments/{commentId} {
        allow read: if isAdmin() || (isVisible() &&
          get(/databases/$(database)/documents/campus_photos/$(photoId))
            .data.moderationStatus == 'visible');
        allow create: if canCreateStudentContent() &&
          request.auth.uid == request.resource.data.authorUid &&
          get(/databases/$(database)/documents/campus_photos/$(photoId))
            .data.moderationStatus == 'visible' && createsVisibleContent();
        allow update: if isAdminModerationUpdate();
        allow delete: if isAdmin() ||
          (isAkdenizStudent() && request.auth.uid == resource.data.authorUid);
      }
    }

    match /board/{itemId} {
      allow read: if isAdmin() || isVisible();
      allow create: if canCreateStudentContent() &&
        request.auth.uid == request.resource.data.authorUid && createsVisibleContent();
      allow update: if isAdminModerationUpdate();
      allow delete: if isAdmin() ||
        (isAkdenizStudent() && request.auth.uid == resource.data.authorUid);
    }

    match /feedback/{feedbackId} {
      allow create: if isAkdenizStudent() && request.auth.uid == request.resource.data.uid;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /cafeteria_ratings/{ratingId} {
      allow read, write: if isAkdenizStudent();
      match /ratings/{uid} {
        allow read: if isAkdenizStudent();
        allow create: if isOwner(uid);
        allow delete: if false;
        allow update: if isAdmin() || (isAkdenizStudent() &&
          request.auth.uid != uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes']) &&
          isValidVoteChange(request.auth.uid));
      }
    }

    match /deletion_jobs/{jobId} {
      allow read, create, update, delete: if isAdmin();
    }
  }
}
