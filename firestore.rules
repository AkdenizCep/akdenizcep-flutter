rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAkdenizStudent() {
      return isSignedIn() &&
        request.auth.token.email.matches('.*@ogr[.]akdeniz[.]edu[.]tr$');
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isClubPresident(clubId) {
      return isAkdenizStudent() &&
        request.auth.uid == get(/databases/$(database)/documents/clubs/$(clubId)).data.adminUid;
    }

    function clubAdminUids(clubId) {
      let club = get(/databases/$(database)/documents/clubs/$(clubId)).data;
      return 'adminUids' in club ? club.adminUids : [];
    }

    // Başkan (adminUid) ya da başkanın eklediği yönetici üye (adminUids).
    function isClubAdmin(clubId) {
      return isClubPresident(clubId) ||
        (isAkdenizStudent() && request.auth.uid in clubAdminUids(clubId));
    }

    // `clubs/{clubId}` dokümanının kendi update kuralı içinde kullanılır —
    // `resource` zaten kulüp dokümanı olduğundan ek bir get() gerekmez.
    function isResourceClubPresident() {
      return isAkdenizStudent() && request.auth.uid == resource.data.adminUid;
    }

    function isResourceClubAdmin() {
      return isResourceClubPresident() ||
        (isAkdenizStudent() &&
          request.auth.uid in ('adminUids' in resource.data ? resource.data.adminUids : []));
    }

    // "votes" haritasında SADECE çağıranın kendi anahtarı eklenmiş/silinmiş/
    // değiştirilmiş olabilir ve varsa değeri 1 (faydalı) ya da -1 (faydasız)
    // olmak zorunda. Başkasının oyu bu yoldan değiştirilemez.
    function isValidVoteChange(uid) {
      let beforeVotes = resource.data.votes is map ? resource.data.votes : {};
      let afterVotes = request.resource.data.votes is map ? request.resource.data.votes : {};
      let voteDiff = afterVotes.diff(beforeVotes);
      return voteDiff.affectedKeys().hasOnly([uid]) &&
        (!(uid in afterVotes) || afterVotes[uid] in [1, -1]);
    }

    // Etkinliklere katılım: bir öğrenci yalnızca "attendeeIds" ve
    // "attendeeCount" alanlarını, yalnızca kendi uid'ini ekleyip çıkararak
    // değiştirebilir. Etkinliğin diğer alanlarına dokunamaz.
    function isValidAttendanceChange(uid) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let beforeIds = resource.data.attendeeIds is list ? resource.data.attendeeIds : [];
      let afterIds = request.resource.data.attendeeIds is list ? request.resource.data.attendeeIds : [];
      let joined = afterIds.toSet().difference(beforeIds.toSet());
      let left = beforeIds.toSet().difference(afterIds.toSet());
      return changed.hasOnly(['attendeeIds', 'attendeeCount']) &&
        joined.hasOnly([uid]) && left.hasOnly([uid]) &&
        request.resource.data.attendeeCount == afterIds.size();
    }

    // Etkinlik altındaki sorular/yorumlar — her iki etkinlik türü için aynı.
    function isCommentAuthor() {
      return isAkdenizStudent() && request.auth.uid == resource.data.authorUid;
    }

    match /users/{uid} {
      allow read: if isAkdenizStudent();
      allow create, update: if isOwner(uid);
      allow delete: if false;
    }

    match /clubs/{clubId} {
      allow read: if isAkdenizStudent();
      allow create, delete: if false;
      // "Takip et/etme" akışında followerCount güncellenir; herhangi bir
      // yönetici (başkan ya da üye) profil alanlarını düzenler; yönetici
      // üye listesi (adminUids) SADECE başkan tarafından değiştirilebilir.
      // Takipçi sayısı ve onay rozeti bu yoldan hiç değiştirilemez.
      allow update: if isAkdenizStudent() && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followerCount']) ||
        (isResourceClubAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'description', 'category', 'logoUrl', 'coverUrl', 'foundedYear'])) ||
        (isResourceClubPresident() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminUids']))
      );

      // isResourceClubPresident() burada KULLANILAMAZ: bu alt koleksiyondaki
      // `resource`, üye dokümanına ait olur, kulübe değil — clubId path
      // değişkeniyle ayrı bir get() yapan isClubPresident() kullanılır.
      match /members/{memberUid} {
        allow read: if isAkdenizStudent();
        allow create, delete: if isClubPresident(clubId);
        allow update: if false;
      }

      match /club-events/{ceventId} {
        allow read: if isAkdenizStudent();
        allow create, delete: if isClubAdmin(clubId);
        // Kulüp yöneticisi her alanı düzenler; diğer öğrenciler yalnızca
        // etkinliğe katılır/ayrılır.
        allow update: if isAkdenizStudent() && (
          isClubAdmin(clubId) ||
          isValidAttendanceChange(request.auth.uid)
        );

        match /comments/{commentId} {
          allow read: if isAkdenizStudent();
          allow create: if isAkdenizStudent() &&
            request.auth.uid == request.resource.data.authorUid;
          allow update, delete: if isCommentAuthor();
        }
      }
    }

    // collectionGroup('club-events') sorgusu için — etkinlik akışı tüm
    // kulüplerin etkinliklerini tek sorguda okur.
    match /{path=**}/club-events/{ceventId} {
      allow read: if isAkdenizStudent();
    }

    match /announcements/{announcementId} {
      allow read: if isAkdenizStudent();
      allow write: if false;
    }

    match /student-events/{seventId} {
      allow read: if isAkdenizStudent();
      allow create: if isAkdenizStudent() &&
        request.auth.uid == request.resource.data.authorUid;
      allow delete: if isAkdenizStudent() &&
        request.auth.uid == resource.data.authorUid;
      // Etkinlik sahibi her alanı düzenler; diğer öğrenciler yalnızca katılır.
      allow update: if isAkdenizStudent() && (
        request.auth.uid == resource.data.authorUid ||
        isValidAttendanceChange(request.auth.uid)
      );

      match /comments/{commentId} {
        allow read: if isAkdenizStudent();
        allow create: if isAkdenizStudent() &&
          request.auth.uid == request.resource.data.authorUid;
        allow update, delete: if isCommentAuthor();
      }
    }

    // Geri bildirimler sadece Firebase Console'dan okunur; uygulama
    // icinde kimse (yazan dahil) kendi veya baskasinin feedback'ini
    // okuyamaz/degistiremez, sadece gonderebilir.
    match /feedback/{feedbackId} {
      allow create: if isAkdenizStudent() &&
        request.auth.uid == request.resource.data.uid;
      allow read, update, delete: if false;
    }

    match /cafeteria_ratings/{ratingId} {
      allow read: if isAkdenizStudent();
      allow write: if isAkdenizStudent();

      match /ratings/{uid} {
        allow read: if isAkdenizStudent();
        allow create: if isOwner(uid);
        allow delete: if false;

        // Yorum sahibi kendi rating/comment alanlarını değiştiremez (mevcut
        // davranış korunur); başka bir öğrenci ise sadece "votes" haritasında
        // kendi oyunu ekleyebilir/değiştirebilir/geri alabilir.
        allow update: if isAkdenizStudent() &&
          request.auth.uid != uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes']) &&
          isValidVoteChange(request.auth.uid);
      }
    }
  }
}
